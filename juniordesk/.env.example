# ----------------------------------------------------------------------------
# JuniorDesk — configuration
#
# Aucune variable n'est obligatoire pour un premier coup d'oeil : sans rien,
# le site demarre et se parcourt integralement sur un jeu d'offres d'exemple
# clairement marque comme tel. Rien n'est collecte, rien n'est envoye.
# ----------------------------------------------------------------------------

# --- Source : La bonne alternance (la seule source active aujourd'hui) ------
#
# Cle API creee sur https://api.apprentissage.beta.gouv.fr/compte/profil
# Choisir une cle de PRODUCTION : la lecture d'offres ne demande aucune
# habilitation. Une cle « sandbox » renverrait les donnees de recette, qui ne
# sont pas les vraies offres.
LBA_API_KEY=

# --- Source : France Travail (inactive) ------------------------------------
#
# L'API Offres d'emploi de France Travail n'est plus exposee publiquement
# depuis octobre 2026 ; l'acces se demande via le formulaire de contact de
# francetravail.io. L'adaptateur est ecrit et teste, mais reste inerte tant
# que ces deux variables sont vides. Les renseigner suffit a l'activer, et a
# faire apparaitre les stages et les postes juniors sur le site.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# --- Persistance -----------------------------------------------------------
#
# OBLIGATOIRE EN PRODUCTION, et plus encore depuis qu'il y a des comptes.
#
# Sans Redis, les offres, les comptes et les inscriptions aux alertes vivent
# en memoire : ils disparaissent au redemarrage, et ne sont pas partages entre
# les processus qui servent le site. Concretement, une personne pourrait creer
# un compte puis ne pas arriver a s'y connecter, sans comprendre pourquoi.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Collecte planifiee ----------------------------------------------------
#
# OBLIGATOIRE EN PRODUCTION : sans ce secret, /api/cron/collect refuse tout
# appel. Une chaine aleatoire longue.
CRON_SECRET=

# --- Alertes e-mail --------------------------------------------------------
#
# Sans cle Resend, les e-mails sont ecrits dans la console au lieu d'etre
# envoyes : on peut tester le parcours d'inscription de bout en bout sans
# rien expedier.
RESEND_API_KEY=
EMAIL_FROM="JuniorDesk <alertes@example.org>"

# Signe les jetons de confirmation et de desinscription des alertes, ainsi
# que les liens de verification d'adresse des comptes, et derive les
# identifiants de compte a partir des adresses.
#
# OBLIGATOIRE EN PRODUCTION : le site refuse de demarrer ces parcours sans
# lui. Une chaine aleatoire longue.
#
# ATTENTION : le changer invalide tous les liens en circulation ET change les
# identifiants derives, donc dissocie les comptes existants de leurs alertes.
# A fixer une fois pour toutes.
ALERTS_SECRET=

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Laisser vide (ou « false ») jusqu'au jour du lancement : tant que les
# mentions legales portent des champs a completer, le site ne doit pas etre
# indexe.
NEXT_PUBLIC_ALLOW_INDEXING=false
